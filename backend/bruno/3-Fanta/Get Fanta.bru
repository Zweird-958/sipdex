meta {
  name: Get Fanta
  type: http
  seq: 3
}

get {
  url: {{baseUrl}}/fanta/{{fantaId}}
  body: none
  auth: none
}

headers {
  ~Authorization: Bearer {{token}}
}

docs {
  Public. Full detail for one fanta (under `result`), using the `fantaId` saved
  by "Create Fanta". Enable the Authorization header to include the `tasted`
  flag for the logged-in user. 404 if the id doesn't exist.
}
