meta {
  name: List Fanta
  type: http
  seq: 2
}

get {
  url: {{baseUrl}}/fanta
  body: none
  auth: none
}

headers {
  ~Authorization: Bearer {{token}}
}

docs {
  Public. Lists all fanta (under `result`) with their countries and a public
  `imageUrl`. Enable the Authorization header (click the checkbox) to also get
  the per-item `tasted` flag for the logged-in user.
}
