{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "types": ["node"],
    "outDir": "./dist",
    "noEmit": true
  },
  "include": [
    "src",
    "scripts",
    "tests",
    "drizzle.config.ts",
    "vitest.config.mts"
  ],
  "exclude": ["node_modules", "dist", "data"]
}
