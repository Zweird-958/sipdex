{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "types": ["node"],
    "outDir": "./dist",
    "noEmit": true
  },
  "include": ["src", "scripts", "drizzle.config.ts"],
  "exclude": ["node_modules", "dist", "data"]
}
