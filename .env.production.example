# ---- Server ----
PORT=3000
# Public base URL of this API (used by better-auth and for building image URLs)
BASE_URL=https://api.your-domain.com

# ---- Postgres ----
# Managed/production database connection string
DATABASE_URL=postgresql://USER:PASSWORD@db-host:5432/fantadex

# ---- better-auth ----
# Generate one with: openssl rand -base64 32
BETTER_AUTH_SECRET=replace-with-a-long-random-secret
BETTER_AUTH_URL=https://api.your-domain.com
# Comma-separated list of trusted origins (web + Expo deep-link scheme)
TRUSTED_ORIGINS=https://app.your-domain.com,fantadex://
# Mobile app deep-link scheme (matches apps/mobile/app.json "scheme")
MOBILE_ORIGIN=mobile://

# ---- S3-compatible object storage ----
# S3 API endpoint used by the AWS SDK client
S3_URL=https://s3.your-domain.com
S3_BUCKET_NAME=fanta-images
S3_ACCESS_KEY_ID=replace-with-access-key
S3_SECRET_ACCESS_KEY=replace-with-secret-key
# Public base URL images are served from (must end with a trailing slash)
S3_PUBLIC_URL=https://cdn.your-domain.com/fanta-images/
