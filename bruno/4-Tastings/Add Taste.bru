meta {
  name: Add Taste
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/fanta/{{fantaId}}/taste
  body: none
  auth: none
}

headers {
  Authorization: Bearer {{token}}
}

docs {
  Adds the fanta (`fantaId` from "Create Fanta") to the logged-in user's tasted
  list. Requires the `tastings:create` permission. 404 if the fanta doesn't
  exist, 401 if not authenticated.
}
