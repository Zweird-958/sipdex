{
  "name": "sipdex",
  "private": true,
  "packageManager": "pnpm@11.12.0",
  "scripts": {
    "dev": "turbo dev",
    "start": "pnpm --filter @sipdex/backend start",
    "mobile": "pnpm --filter @sipdex/mobile start",
    "mobile:ios": "pnpm --filter @sipdex/mobile ios",
    "mobile:android": "pnpm --filter @sipdex/mobile android",
    "mobile:web": "pnpm --filter @sipdex/mobile web",
    "typecheck": "turbo typecheck",
    "lint": "turbo lint",
    "lint:fix": "turbo lint -- --fix",
    "format": "prettier --check .",
    "format:fix": "prettier --write .",
    "knip": "knip",
    "test:unit": "pnpm --filter @sipdex/api test:unit",
    "test:api": "pnpm --filter @sipdex/api test:api",
    "test:integration": "pnpm --filter @sipdex/api test:integration",
    "db:generate": "pnpm --filter @sipdex/api db:generate",
    "db:migrate": "pnpm --filter @sipdex/api db:migrate",
    "db:push": "pnpm --filter @sipdex/api db:push",
    "db:studio": "pnpm --filter @sipdex/api db:studio",
    "seed": "pnpm --filter @sipdex/api seed",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down",
    "env-symlink": "ln -sf $PWD/.env ./apps/backend/.env && ln -sf $PWD/.env ./packages/api/.env",
    "prepare": "husky"
  },
  "devDependencies": {
    "@trivago/prettier-plugin-sort-imports": "^6.0.2",
    "husky": "^9.1.7",
    "knip": "^5.66.0",
    "prettier": "^3.9.5",
    "turbo": "^2.5.0"
  }
}
