{
  "name": "fantadex",
  "private": true,
  "packageManager": "pnpm@11.12.0",
  "scripts": {
    "dev": "pnpm --filter @fantadex/backend dev",
    "start": "pnpm --filter @fantadex/backend start",
    "typecheck": "pnpm --filter @fantadex/backend typecheck",
    "lint": "pnpm --filter @fantadex/backend lint",
    "lint:fix": "pnpm --filter @fantadex/backend lint:fix",
    "format": "prettier --check .",
    "format:fix": "prettier --write .",
    "knip": "knip",
    "db:generate": "pnpm --filter @fantadex/backend db:generate",
    "db:migrate": "pnpm --filter @fantadex/backend db:migrate",
    "db:push": "pnpm --filter @fantadex/backend db:push",
    "db:studio": "pnpm --filter @fantadex/backend db:studio",
    "make-admin": "pnpm --filter @fantadex/backend make-admin",
    "docker:up": "pnpm --filter @fantadex/backend docker:up",
    "docker:down": "pnpm --filter @fantadex/backend docker:down",
    "seed": "pnpm --filter @fantadex/backend seed",
    "prepare": "husky"
  },
  "devDependencies": {
    "@trivago/prettier-plugin-sort-imports": "^6.0.2",
    "husky": "^9.1.7",
    "knip": "^5.66.0",
    "prettier": "^3.9.5"
  }
}
