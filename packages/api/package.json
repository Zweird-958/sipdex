{
  "name": "@fantadex/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./index.ts",
    "./server": "./server.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test:unit": "vitest run --project unit",
    "test:api": "vitest run --project api",
    "test:integration": "NODE_ENV=test pnpm run db:reset && NODE_ENV=test pnpm run db:migrate && NODE_ENV=test vitest run --project integration",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "db:reset": "tsx scripts/db-reset.ts",
    "seed": "tsx scripts/seed.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.699.0",
    "@hono/zod-validator": "^0.8.0",
    "better-auth": "^1.6.23",
    "dotenv": "^17.4.2",
    "drizzle-orm": "^0.45.2",
    "hono": "^4.12.28",
    "hono-pino": "^0.10.3",
    "i18n-iso-countries": "^7.14.0",
    "pg": "^8.22.0",
    "pino": "^10.3.1",
    "slugify": "^1.6.9",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@faker-js/faker": "^10.5.0",
    "@fantadex/eslint": "workspace:*",
    "@fantadex/typescript": "workspace:*",
    "@types/node": "catalog:",
    "@types/pg": "^8.20.0",
    "drizzle-kit": "^0.31.10",
    "drizzle-seed": "^0.3.1",
    "eslint": "catalog:",
    "pino-pretty": "^13.1.3",
    "tsx": "^4.7.1",
    "typescript": "catalog:",
    "vitest": "^4.1.10"
  }
}
