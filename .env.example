# ---- Server ----
PORT=3000
# Public base URL of this API (used by better-auth and for building image URLs)
BASE_URL=http://localhost:3000

# ---- Postgres ----
POSTGRES_USER=fantadex
POSTGRES_PASSWORD=fantadex
POSTGRES_DB=fantadex
POSTGRES_PORT=5432
DATABASE_URL=postgresql://fantadex:fantadex@localhost:5432/fantadex

# ---- Postgres (test) — used by the integration test suite ----
POSTGRES_TEST_USER=fantadex
POSTGRES_TEST_PASSWORD=fantadex
POSTGRES_TEST_DB=fantadex_test
POSTGRES_TEST_PORT=5433
DATABASE_URL_TEST=postgresql://fantadex:fantadex@localhost:5433/fantadex_test

# ---- better-auth ----
# Generate one with: openssl rand -base64 32
BETTER_AUTH_SECRET=change-me-in-production-please-use-a-long-random-string
BETTER_AUTH_URL=http://localhost:3000
# Comma-separated list of trusted origins (web + Expo deep-link scheme)
TRUSTED_ORIGINS=http://localhost:3000,http://localhost:8081,fantadex://

# ---- RustFS (S3-compatible object storage) ----
S3_PORT=9000
S3_CONSOLE_PORT=9001
# S3 API endpoint used by the AWS SDK client
S3_URL=http://localhost:9000
S3_BUCKET_NAME=fanta-images
S3_ACCESS_KEY_ID=rustfsadmin
S3_SECRET_ACCESS_KEY=rustfsadmin
# Public base URL images are served from (must end with a trailing slash)
S3_PUBLIC_URL=http://localhost:9000/fanta-images/

